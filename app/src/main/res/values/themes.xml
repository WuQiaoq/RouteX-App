<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.RouteXApp" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorPrimaryVariant">@color/color_primary_dark</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <item name="colorSecondary">@color/color_secondary</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/bg_light</item>
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Card style base -->
    <style name="Widget.App.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Button primary -->
    <style name="Widget.App.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/color_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_sm</item>
        <item name="android:minHeight">@dimen/btn_height</item>
        <item name="cornerRadius">@dimen/btn_radius</item>
    </style>

    <!-- Button outline -->
    <style name="Widget.App.Button.Outline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/color_primary</item>
        <item name="android:textColor">@color/color_primary</item>
        <item name="android:textSize">@dimen/text_sm</item>
        <item name="android:minHeight">@dimen/btn_height</item>
        <item name="cornerRadius">@dimen/btn_radius</item>
    </style>

    <!-- TabLayout -->
    <style name="Widget.App.TabLayout" parent="Widget.MaterialComponents.TabLayout">
        <item name="tabSelectedTextColor">@color/tab_selected</item>
        <item name="tabTextColor">@color/tab_unselected</item>
        <item name="tabIndicatorColor">@color/tab_indicator</item>
        <item name="tabIndicatorHeight">@dimen/tab_indicator_height</item>
        <item name="tabBackground">@color/white</item>
        <item name="tabTextAppearance">@style/TextAppearance.App.Tab</item>
    </style>

    <style name="TextAppearance.App.Tab" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">@dimen/text_sm</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>